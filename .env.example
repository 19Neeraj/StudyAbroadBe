# Copy to .env.development / .env.staging / .env.production (never commit real values).
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
LOG_PRETTY=true

MONGO_URI=mongodb://localhost:27017/study_abroad_crm
MONGO_MAX_POOL_SIZE=20
# Background jobs: set JOBS_DRIVER=bullmq (with a running Redis) for production-grade queues.
# Without it, jobs run in-process (fine for development).
REDIS_URL=redis://localhost:6379
# JOBS_DRIVER=bullmq

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Encrypts integration credentials (calling provider keys) at rest. Required in production.
ENCRYPTION_KEY=

CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
TRUST_PROXY=0
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_IP_MAX=3000
AUTH_RATE_LIMIT_MAX=20
REFRESH_RATE_LIMIT_MAX=120

APP_URL=http://localhost:3000
# Public URL of this API: calling-provider webhooks and signed file links point here.
API_PUBLIC_URL=http://localhost:4000

# Object storage for recordings and documents: local (dev) or s3 (AWS / S3-compatible).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# AWS_REGION=ap-south-1
# AWS_BUCKET=
# AWS_ACCESS_KEY=
# AWS_SECRET_KEY=
# S3_ENDPOINT=
SIGNED_URL_TTL_SECONDS=300

# console | smtp
EMAIL_PROVIDER=console
EMAIL_FROM="Study Abroad CRM <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Used by `npm run seed` to create the platform Super Admin
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=
